/* ============================================================
 *  存储器布局配置
 *  ============================================================
 *  当前芯片：STM32F407VGT6
 *
 *  CubeMX --- 中可能显示：
 *    Flash    = 1024K
 *    RAM Total = 192K
 *
 *  但在 Rust 裸机工程的 linker script 中，
 *  不应直接把 RAM 写成：
 *    ORIGIN = 0x20000000, LENGTH = 192K
 *
 *  原因：
 *  STM32F407VGT6 的 192K RAM 不是从 0x20000000
 *  开始连续分布的一整块普通 SRAM。
 *
 *  推荐初学工程先使用主 SRAM：
 *    主 SRAM 地址：0x20000000
 *    主 SRAM 大小：128K
 *
 *  额外的 64K CCM RAM 属于独立区域，地址不在
 *  0x20000000 后面连续空间中，暂不在本工程使用。
 *
 *  如果把 RAM 写成 192K，栈顶会变成：
 *    0x20000000 + 192K = 0x20030000
 *
 *  这可能导致启动后 double fault / lockup。
 * ============================================================ */

MEMORY
{
  FLASH  : ORIGIN = 0x08000000, LENGTH = 1024K
  RAM    : ORIGIN = 0x20000000, LENGTH = 128K
  CCMRAM : ORIGIN = 0x10000000, LENGTH = 64K
}

_stack_start = ORIGIN(RAM) + LENGTH(RAM);